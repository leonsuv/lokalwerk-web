{
  "name": "lokalwerk-web",
  "version": "0.1.0",
  "private": true,
  "description": "Lokalwerk – Werkzeuge für Dateien, die ausschließlich im Browser laufen.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.dom-tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "perf:werkstatt": "npm run build && node scripts/perf-werkstatt.mjs",
    "compat:pdfjs": "npm run build && node scripts/pdfjs-compat.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/onest": "5.3.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "uqr": "0.1.3",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  }
}
